# Gemini API Configuration
# Copy this file to .env for local testing (DO NOT commit .env)

# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token (automatically provided by GitHub Actions)
# For local testing, create a personal access token: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Repository information (format: owner/repo)
GITHUB_REPOSITORY=your-username/your-repo

# Issue or PR number
ISSUE_NUMBER=1

# Comment body (for testing @gemini-cli mentions)
COMMENT_BODY="@gemini-cli please implement this feature"
